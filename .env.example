# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Base URL of the frontend app — used to build links in transactional emails
# (e.g. newsletter confirm/unsubscribe/preferences links).
FRONTEND_URL=http://localhost:5173

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption (AES-256-GCM for integration credentials) ─────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-key-here

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/crm_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── File Storage (AWS S3 or MinIO) ────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=crm-assets
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTHENTICATED=100
RATE_LIMIT_MAX_PUBLIC=10

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Bull Board (admin job monitoring UI) ──────────────────────────────────────
BULL_BOARD_PORT=3001

# ── Inbound Webhooks (signature/token verification) ───────────────────────────
# WhatsApp Cloud API — Meta App Dashboard → WhatsApp → Configuration
#   Verify token: any string you choose, entered in Meta's "Configure webhooks" screen
#   App secret: used to verify X-Hub-Signature-256 on inbound POSTs
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
# Facebook Lead Ads — falls back to WHATSAPP_VERIFY_TOKEN / WHATSAPP_APP_SECRET if unset
FACEBOOK_VERIFY_TOKEN=choose-a-verify-token
FACEBOOK_APP_SECRET=your-meta-app-secret
# Twilio — used to verify X-Twilio-Signature on inbound SMS/status webhooks
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# SendGrid — Event Webhook signed events verification key
SENDGRID_VERIFICATION_KEY=your-sendgrid-verification-key
# Google Ads — shared secret expected in the lead form webhook payload
GOOGLE_ADS_WEBHOOK_SECRET=your-google-ads-webhook-secret

# ── Scraper API Keys ──────────────────────────────────────────────────────────
# These variable NAMES must match the "apiKeyRef" / "accessTokenRef" field you
# set when creating a scraper config in the UI.  Store the actual key here;
# store only the variable NAME in the scraper config (e.g. "GOOGLE_PLACES_API_KEY").
#
# Google Places API — enable "Places API" in Google Cloud Console
GOOGLE_PLACES_API_KEY=AIzaSy...
# YouTube Data API v3 — enable "YouTube Data API v3" in Google Cloud Console
YOUTUBE_API_KEY=AIzaSy...
# Facebook Graph API — generate a long-lived Page Access Token in Meta Business Suite
FACEBOOK_ACCESS_TOKEN=EAAxxxxxxx...

# Browser (Puppeteer) scraper — path to a locally installed Chrome/Chromium
# binary. Required only if you create a "browser_scrape" scraper source.
# puppeteer-core does not bundle a browser; install Chrome and point here
# (e.g. /usr/bin/google-chrome on Debian/Ubuntu).
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
